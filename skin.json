{
  "name": "Glass Dusk ES",
  "description": "Cristal ahumado sobre la ilustración del juego abierto, que define el color de acento del cliente. Personaliza la biblioteca, la tienda, los menús, Big Picture y la superposición del juego. Traducción al español de Glass Dusk.",
  "author": "Yareli",
  "version": "1.7.2",
  "tags": [
    "Dark",
    "Glass",
    "Dynamic",
    "Big Picture"
  ],
  "github": {
    "owner": "Tomacods",
    "repo_name": "glass-dusk-ES"
  },
  "funding": {
    "kofi": "yareli0i"
  },
  "header_image": "https://raw.githubusercontent.com/Yareli0i/glass-dusk/main/images/header.jpg",
  "splash_image": "https://raw.githubusercontent.com/Yareli0i/glass-dusk/main/images/splash.jpg",
  "Steam-WebKit": "css/webkit.css",
  "RootColors": "css/root.css",
  "Conditions": {
